# Comma-separated origins are not needed during Sprint 1; set one frontend origin.
FRONTEND_ORIGIN=http://localhost:5173

# Neon PostgreSQL connection string. The application accepts a standard
# postgresql:// URL and uses the psycopg SQLAlchemy driver automatically.
DATABASE_URL=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require

# Generic LLM selection. Set this to "gemini" or "groq".
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash

# Gemini credential used when LLM_PROVIDER=gemini. Keep the real value only in
# your ignored local .env file or deployment environment.
GEMINI_API_KEY=your-gemini-api-key

# Groq configuration used when LLM_PROVIDER=groq.
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
